{
    "name": "ernestdefoe/mural",
    "description": "Mural: one shared pixel canvas the whole forum paints together. One tile per cooldown, smooth pan and zoom on mouse and touch, live updates, seasons with a saved picture and a timelapse, a gallery, stats and moderation tools.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "mural",
        "pixel art",
        "canvas",
        "place",
        "community",
        "game"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/mural",
    "support": {
        "issues": "https://github.com/ernestdefoe/mural/issues",
        "source": "https://github.com/ernestdefoe/mural"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zlib": "*",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Mural\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Mural\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Mural",
            "category": "feature",
            "icon": {
                "name": "fas fa-palette",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/realtime",
                "ernestdefoe/cadence"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
